# Example nginx config for the RomeAPI static build.
#
# Layout on the server:
#   /usr/share/nginx/html/          <- contents of the `build/` directory
#   /usr/share/nginx/html/test/     <- your API spec files (optional)
#   /usr/share/nginx/html/settings.yml
#   /usr/share/nginx/html/branding/ <- your logo/favicon (optional)
#
# `createBrowserRouter` uses real paths (/service/:serviceName/...), so the
# SPA fallback (`try_files ... /index.html`) is REQUIRED, otherwise a direct
# link or a page reload returns 404.

server {
    listen       80;
    server_name  rome-api.local;
    root         /usr/share/nginx/html;
    index        index.html;

    # SPA fallback for react-router routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Specs and the settings file must not be cached aggressively: they are
    # updated independently of the frontend build.
    location ~* \.(json|ya?ml)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # `settings.js` is the fallback for `settings.yml` and is edited on the server
    # too. The exact match wins over the asset rule below, which would otherwise
    # cache it as immutable for a year — and a rebrand would not show up.
    location = /settings.js {
        add_header Cache-Control "no-cache";
    }

    # Branding assets (logo, favicon) referenced from `settings.yml` are replaced
    # independently of the build. `^~` is required: without it the regex rules below
    # take precedence and pin these files in the browser cache for a year.
    location ^~ /branding/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Hashed build artifacts can be cached forever.
    location ~* \.(js|css|woff2?|ttf|eot|png|webp|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
